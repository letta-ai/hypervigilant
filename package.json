{
  "name": "hypervigilant",
  "version": "0.1.0",
  "description": "Trigger persistent Letta agents from file changes.",
  "type": "module",
  "bin": {
    "hypervigilant": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE",
    ".env.example",
    "hypervigilant.example.toml",
    "hypervigilant.schema.json",
    "demo/cloud-local-device/README.md",
    "demo/cloud-local-device/run.ts",
    "demo/model-routing/README.md",
    "demo/model-routing/run.ts",
    "demo/spec-guardian/README.md",
    "demo/spec-guardian/SPEC.md",
    "demo/spec-guardian/hypervigilant.toml.example",
    "demo/spec-guardian/scripts",
    "demo/spec-guardian/src",
    "demo/spec-guardian/tests",
    "demo/the-doc/README.md",
    "demo/the-doc/index.html",
    "demo/the-doc/app.js",
    "demo/the-doc/activity.ts",
    "demo/the-doc/styles.css",
    "demo/the-doc/server.ts",
    "demo/the-doc/hypervigilant.toml.example",
    "demo/the-doc/scripts",
    "demo/the-doc/tests",
    "demo/the-doc/PROJECT.md.example"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts demo",
    "format": "biome format --write src tests scripts demo",
    "test": "bun test tests/*.test.ts",
    "test:demo": "bun test demo/cloud-local-device/run.test.ts demo/spec-guardian/tests/greeting.test.ts demo/the-doc/tests/activity.test.ts demo/the-doc/tests/server.test.ts",
    "demo:cloud-local-device": "bun run demo/cloud-local-device/run.ts",
    "demo:the-doc": "bun run demo/the-doc/scripts/run.ts",
    "demo:the-doc:setup": "bun run demo/the-doc/scripts/setup.ts",
    "demo:the-doc:editor": "bun run demo/the-doc/server.ts",
    "demo:the-doc:reset": "bun run demo/the-doc/scripts/reset.ts",
    "test:live": "HYPERVIGILANT_LIVE_TEST=1 bun test tests/live.test.ts",
    "spec:check": "bun run scripts/check-specs.ts",
    "spec:update": "bun run scripts/check-specs.ts --update",
    "check": "bun run spec:check && bun run typecheck && bun run lint && bun run test && bun run build",
    "quality": "bun run scripts/quality.ts"
  },
  "keywords": [
    "letta",
    "ai-agent",
    "persistent-agent",
    "file-watcher",
    "filesystem",
    "automation",
    "diff",
    "cli"
  ],
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@letta-ai/letta-agent-sdk": "0.6.0",
    "@letta-ai/letta-code": "0.30.0",
    "chokidar": "^4.0.3",
    "diff": "^8.0.2",
    "picomatch": "^4.0.3",
    "zod": "^4.0.15"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@types/bun": "latest",
    "@types/picomatch": "^4.0.2",
    "typescript": "^5.9.2"
  }
}
