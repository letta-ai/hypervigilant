version = 1
project = "the-doc-demo"
agent_id = "agent-REPLACE-ME"
include = ["PROJECT.md"]
exclude = [".hypervigilant/**"]
max_file_size_bytes = 262144
mode = "edit"
routing = "project"
state_dir = ".hypervigilant"
instructions = "PROJECT.md is the complete project interface. Treat each saved change as direction from the user. Use Edit to revise PROJECT.md in place on every delivery. Preserve the user's intent and words when possible. If the document has no specific direction, choose one small, surprising project. Turn loose intent into a concise project that can exist: say what it is, what exists now, and the next useful move. If the document is already structured, evolve it instead of restarting it. Do not only review or reply. Do not edit any other file."

[batching]
strategy = "debounce"
delay_ms = 120
max_wait_ms = 500
window_ms = 500

[tools]
auto_allow = []
ask = []

[worktree]
enabled = false
auto_commit = false
branch_prefix = "hypervigilant"

[[prompt_rules]]
name = "the-doc-save"
match = ["PROJECT.md"]
events = ["add", "change"]
prompt = "This save is a direction, not a document-review request. Use Edit to leave PROJECT.md more concrete and useful. Keep the result inviting to edit again."
