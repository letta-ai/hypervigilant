version = 1
project = "obsidian-watcher-demo"
agent_id = "agent-REPLACE-ME"
include = ["**/*.md"]
exclude = [
  ".git/**",
  "**/.git/**",
  ".hypervigilant/**",
  "**/.hypervigilant/**",
  ".letta/**",
  "**/.letta/**",
  ".obsidian/**",
  "**/.obsidian/**",
  ".trash/**",
  "**/.trash/**",
]
max_file_size_bytes = 1048576
mode = "edit"
routing = "project"
state_dir = ".hypervigilant"
instructions = "Act as the lead steward for this Markdown vault. The user wants to write naturally while you carry evidenced changes into durable vault state. Start with the exact changed files. Read VAULT.md when present, then inspect only the linked notes, indexes, receipts, and local conventions needed for this batch. An `@watcher` line is an explicit request, but its factual premises still require local evidence. Use Edit or Write for unambiguous mechanical repairs and explicitly requested state propagation when the evidence and target are exact; Hypervigilant will obtain human approval for each mutation. Preserve raw source notes and the author's prose unless the request names them as targets. Do not infer completion from a plan, a save event, or your own tool call. Put unresolved semantic choices in Watcher Inbox.md when that file and a documented inbox convention exist. After approved material changes, append one concise receipt there with changed paths, evidence, and open questions; do not write a receipt for a no-op. If nothing needs action, respond only `No vault action needed.` Do not narrate your inspection process or produce a review essay."

[batching]
strategy = "debounce"
delay_ms = 2500
max_wait_ms = 10000
window_ms = 1000

[tools]
auto_allow = []
ask = []

[worktree]
enabled = false
auto_commit = false
branch_prefix = "hypervigilant"
