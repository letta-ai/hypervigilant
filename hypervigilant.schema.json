{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypervigilant TOML Configuration",
  "description": "Schema for the keys parsed from hypervigilant.toml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "agent_id"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. Must be 1."
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Display name for the project."
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Letta agent ID (agent-xxx)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Optional model for Hypervigilant-owned conversations. Does not change the agent default."
    },
    "include": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": ["**/*.md", "**/*.txt"],
      "description": "Globs to include, relative to the project root."
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": [
        "**/node_modules/**",
        "**/.git/**",
        ".hypervigilant/**",
        "**/.hypervigilant/**"
      ],
      "description": "Globs to exclude, relative to the project root."
    },
    "max_file_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 1048576,
      "description": "Maximum watched-file size in bytes."
    },
    "max_scan_files": {
      "type": "integer",
      "minimum": 1,
      "default": 100,
      "description": "Maximum number of files in one scan."
    },
    "max_scan_text_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 65536,
      "description": "Maximum total text bytes in one scan. Binary files send metadata only and do not count toward this limit."
    },
    "mode": {
      "type": "string",
      "enum": ["review", "edit"],
      "default": "edit",
      "description": "Agent mode. Edit mode requires approval for every mutation."
    },
    "routing": {
      "type": "string",
      "enum": ["project", "per-file"],
      "default": "project",
      "description": "Conversation routing strategy."
    },
    "state_dir": {
      "type": "string",
      "minLength": 1,
      "default": ".hypervigilant",
      "description": "Private state directory, relative to the project root or absolute."
    },
    "instructions": {
      "type": "string",
      "default": "",
      "description": "Optional project-specific instructions appended to each review request."
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "description": "Additional local Agent SDK client tools and their Hypervigilant approval policy.",
      "properties": {
        "auto_allow": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "enum": ["Read", "LS", "Glob", "Grep", "Edit", "Write", "AskUserQuestion", "Bash", "BashOutput", "KillBash", "shell_command", "ShellCommand", "exec_command", "write_stdin", "shell", "Shell", "run_shell_command", "RunShellCommand", "Task", "Agent", "TaskOutput", "TaskStop", "EnterWorktree", "MultiEdit", "apply_patch", "ApplyPatch", "replace", "Replace", "write_file_gemini", "write_file", "WriteFileGemini", "memory", "memory_apply_patch"]
            }
          }
        },
        "ask": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "enum": ["Read", "LS", "Glob", "Grep", "Edit", "Write", "AskUserQuestion", "Bash", "BashOutput", "KillBash", "shell_command", "ShellCommand", "exec_command", "write_stdin", "shell", "Shell", "run_shell_command", "RunShellCommand", "Task", "Agent", "TaskOutput", "TaskStop", "EnterWorktree", "MultiEdit", "apply_patch", "ApplyPatch", "replace", "Replace", "write_file_gemini", "write_file", "WriteFileGemini", "memory", "memory_apply_patch"]
            }
          }
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional isolated Git worktree for watched changes and approved agent repairs.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Create and reuse an isolated Git branch/worktree."
        },
        "auto_commit": {
          "type": "boolean",
          "default": true,
          "description": "Commit each successfully delivered batch in the isolated worktree."
        },
        "branch_prefix": {
          "type": "string",
          "minLength": 1,
          "default": "hypervigilant",
          "description": "Safe Git branch prefix used for generated worktree branches."
        }
      }
    },
    "prompt_rules": {
      "type": "array",
      "default": [],
      "description": "Ordered canned prompts selected by project-relative path and change event.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "match", "prompt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "default": ["add", "change", "delete"],
            "items": { "type": "string", "enum": ["add", "change", "delete"] }
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "conversation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "Optional persistent filesystem-read-only conversation route name."
          }
        }
      }
    },
    "batching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["debounce", "fixed-window", "immediate"],
          "default": "debounce"
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 500,
          "description": "Debounce delay in milliseconds."
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Maximum debounce wait in milliseconds."
        },
        "window_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 2000,
          "description": "Fixed-window duration in milliseconds."
        }
      }
    }
  }
}
